    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krasip uses Apple speech recognition to turn your Thai and English speech into text."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krasip ใช้การรู้จำเสียงพูดของ Apple เพื่อแปลงเสียงภาษาไทยและอังกฤษของคุณเป็นข้อความ"
