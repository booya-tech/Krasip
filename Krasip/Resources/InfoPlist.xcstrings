      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krasip listens only while you hold the dictation shortcut, then turns your speech into text."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krasip จะฟังเฉพาะตอนที่คุณกดคีย์ลัดค้างไว้ แล้วแปลงเสียงพูดของคุณเป็นข้อความ"
          }
        }
      }
